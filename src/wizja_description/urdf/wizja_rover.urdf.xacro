<?xml version="1.0"?>
<!--
  Rover 3.0 (rover30) visual model with the depth cameras of lr_wizja_kamery.

  >>> CAMERA POSITIONS ARE EDITED IN THIS FILE: see the "CAMERA POSITIONS" block below. <<<
  After editing, rebuild the wizja_description package (exact commands in README, "Changing camera
  positions"), then check with view_model.launch.py and coverage_map.py.
  wizja_bringup/config/cameras.yaml only says WHICH cameras exist (serials, driver/external, topics);
  every camera listed there must be placed here under its frame prefix (camera_<name>, or its
  frame_prefix), otherwise the launch files stop with an error.

  Rover geometry, joint origins/limits and meshes are taken from Aut-Main rover30_description
  (rover30_ASSEMBLY_NEW.urdf.xacro, simplified meshes). The lidar is left out: the cameras replace it.

  Args:
    include_rover          true:  full model, root base_footprint (standalone / laptop / simulator)
                           false: only base_link + camera post + side cameras, for running next to the
                                  main rover stack whose robot_state_publisher already publishes the
                                  rover and the front camera (camera_link ...)
    nominal_camera_frames  true: also add <name>_depth_frame / _depth_optical_frame. Only for
                           the simulator - on hardware the realsense driver publishes them (publish_tf).
-->
<robot name="rover30_wizja" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="include_rover" default="true"/>
  <xacro:arg name="nominal_camera_frames" default="false"/>

  <xacro:property name="include_rover" value="${'$(arg include_rover)'.lower() in ('true', '1')}"/>
  <xacro:property name="nominal_frames" value="${'$(arg nominal_camera_frames)'.lower() in ('true', '1')}"/>
  <xacro:property name="mesh_dir" value="package://wizja_description/meshes"/>

  <!-- base_footprint (ground contact plane) -> base_link, from rover30_BASE_PLATFORM.xacro -->
  <xacro:property name="base_link_height" value="0.37956"/>
  <!-- Top of the deck in base_link (measured from base_link.stl) -->
  <xacro:property name="deck_top_z" value="0.18"/>

  <!-- Camera post for the side cameras: where the lidar used to be (rover30 laser_joint xyz 0.33 0 0.185).
       Visual only (+ simulator occlusion box in wizja_bringup/rover_geometry.py). -->
  <xacro:property name="post_x" value="0.33"/>
  <xacro:property name="post_y" value="0.0"/>
  <xacro:property name="post_height" value="0.20"/>
  <xacro:property name="post_radius" value="0.02"/>

  <!-- One D455, placed by its tripod-screw frame (bottom centre of the camera = what you measure).
       <name>_link = realsense body frame (X out of the lens, origin at the left IR imager = depth
       origin), the frame realsense2_camera hangs its optical frames on. Offsets and visual from
       rover30 include/rs_d455.urdf.xacro. Do not edit - edit the CAMERA POSITIONS block below. -->
  <xacro:macro name="d455" params="name parent xyz rpy">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_bottom_screw_frame"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <link name="${name}_bottom_screw_frame"/>
    <joint name="${name}_link_joint" type="fixed">
      <parent link="${name}_bottom_screw_frame"/>
      <child link="${name}_link"/>
      <origin xyz="0.01115 0.0475 0.0145" rpy="0 0 0"/>
    </joint>
    <link name="${name}_link">
      <visual>
        <origin xyz="${4.55e-3 + 0.1e-3} -0.0475 0" rpy="${pi/2} 0 ${pi/2}"/>
        <geometry><mesh filename="${mesh_dir}/rs_d455.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="aluminum"/>
      </visual>
    </link>
    <xacro:if value="${nominal_frames}">
      <joint name="${name}_depth_joint" type="fixed">
        <parent link="${name}_link"/>
        <child link="${name}_depth_frame"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
      <link name="${name}_depth_frame"/>
      <joint name="${name}_depth_optical_joint" type="fixed">
        <parent link="${name}_depth_frame"/>
        <child link="${name}_depth_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      </joint>
      <link name="${name}_depth_optical_frame"/>
    </xacro:if>
  </xacro:macro>

  <!-- ================================== CAMERA POSITIONS ==================================
       xyz = position of the camera's TRIPOD SCREW (bottom centre of the D455) in base_link:
             x forward, y left, z up, metres. base_link = rover centre, 0.38 m above the ground,
             deck top at z = 0.18.
       rpy = roll pitch yaw in radians (URDF convention): pitch > 0 tilts the camera DOWN,
             yaw > 0 turns it to the LEFT (+1.5708 = facing left, -1.5708 = facing right).
       The camera's depth origin (<name>_link) is 1.1 cm in front of, 4.75 cm left of and
       1.45 cm above the screw (in the camera's own frame).
       ======================================================================================= -->

  <!-- Left / right: our drivers, on the post where the lidar used to be. Yaw +/-80 deg (not 90) so
       the front diagonals overlap with the front camera; 20 deg down. DESIGN VALUES - measure after
       mounting. -->
  <xacro:d455 name="camera_left"  parent="base_link" xyz="0.28910 0.08254 0.38520" rpy="0 0.35 1.3963"/>
  <xacro:d455 name="camera_right" parent="base_link" xyz="0.28854 -0.08304 0.38520" rpy="0 0.35 -1.3963"/>

  <!-- Front ("Center"): the rover's existing D455, owned by the main stack, which publishes its TF
       from Aut-Main rover30_description (camera_joint). Only added in the full model; if it is moved,
       change it HERE AND in rover30_description so both stay equal. -->
  <xacro:if value="${include_rover}">
    <xacro:d455 name="camera" parent="base_link" xyz="0.42 0.0 0.18" rpy="0 0 0"/>
  </xacro:if>

  <material name="purple"><color rgba="${114/255} 0 1 1"/></material>
  <material name="steer_blue"><color rgba="${202/255} ${209/255} ${238/255} 1"/></material>
  <material name="wheel_gray"><color rgba="${192/255} ${192/255} ${192/255} 1"/></material>
  <material name="aluminum"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <!-- ===================================== Rover body ===================================== -->
  <xacro:if value="${include_rover}">
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_link_height}" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <link name="base_link">
    <xacro:if value="${include_rover}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/base_rockers.stl"/></geometry>
        <material name="purple"/>
      </visual>
    </xacro:if>
  </link>

  <xacro:macro name="steer_wheel" params="prefix xyz wheel_xyz">
    <link name="${prefix}_steer_link">
      <visual>
        <geometry><mesh filename="${mesh_dir}/${prefix}_steer_link.stl"/></geometry>
        <material name="steer_blue"/>
      </visual>
    </link>
    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steer_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100" lower="${-pi/2}" upper="${pi/2}" velocity="2.0"/>
    </joint>
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry><mesh filename="${mesh_dir}/${prefix}_wheel_link.stl"/></geometry>
        <material name="wheel_gray"/>
      </visual>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100" velocity="10.0"/>
    </joint>
  </xacro:macro>

  <xacro:if value="${include_rover}">
    <xacro:steer_wheel prefix="left_front" xyz="0.48131 0.37355 -0.053034" wheel_xyz="-0.00010481 -0.058502 -0.21094"/>
    <xacro:steer_wheel prefix="right_front" xyz="0.48137 -0.37345 -0.052825" wheel_xyz="0 0.058502 -0.21094"/>
    <xacro:steer_wheel prefix="left_rear" xyz="-0.36144 0.37355 -0.052615" wheel_xyz="-0.00010481 -0.058502 -0.21094"/>
    <xacro:steer_wheel prefix="right_rear" xyz="-0.36137 -0.37345 -0.052825" wheel_xyz="0 0.058502 -0.21094"/>
  </xacro:if>

  <!-- ================================ Camera post + cluster ================================ -->
  <link name="camera_post_link">
    <visual>
      <origin xyz="0 0 ${post_height / 2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${post_radius}" length="${post_height}"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <!-- mounting plate the side cameras sit on -->
      <origin xyz="-0.02 0 ${post_height - 0.003}" rpy="0 0 0"/>
      <geometry><box size="0.16 0.24 0.006"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="camera_post_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_post_link"/>
    <origin xyz="${post_x} ${post_y} ${deck_top_z}" rpy="0 0 0"/>
  </joint>

</robot>
