<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_only</transport_id>
                <type>UDPv4</type>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="udp_only_participant" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>udp_only</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
            </rtps>
        </participant>
        <!-- Belt-and-suspenders: explicitly disable Data-Sharing delivery too, since it is
             a separate QoS-level feature from the transport layer above and has its own
             known busy-loop bug for late-joining readers matching an active writer
             (eProsima/Fast-DDS#6338). -->
        <data_reader profile_name="udp_only_reader" is_default_profile="true">
            <qos>
                <data_sharing>
                    <kind>OFF</kind>
                </data_sharing>
            </qos>
        </data_reader>
        <data_writer profile_name="udp_only_writer" is_default_profile="true">
            <qos>
                <data_sharing>
                    <kind>OFF</kind>
                </data_sharing>
            </qos>
        </data_writer>
    </profiles>
</dds>
